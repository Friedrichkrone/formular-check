{
  "name": "@schwerpunkt/formular-check",
  "version": "0.1.0",
  "private": true,
  "description": "Static accessibility check for HTML forms: findings with WCAG 2.2 criterion, severity, explanation and fix. Library and command line tool.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "forms",
    "bfsg",
    "bitv",
    "html",
    "cli"
  ],
  "license": "MIT",
  "author": "Schwerpunkt FdG Labs UG (haftungsbeschränkt) (https://schwerpunkt.tech)",
  "homepage": "https://schwerpunkt.tech/werkzeuge/formular-barrierefreiheit-pruefen",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "formular-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
